# Copy to .env and fill in. .env is gitignored; this file must stay free of real values.
#
# Load it before running the server:
#   set -a; . ./.env; set +a
#   uvicorn dbt_sentinel.webhook:app --port 8000
#
# On a host (Railway/Fly/Render) set these as environment variables instead.

# --- GitHub App: required for the webhook to do anything ---

# App settings page, "App ID". A number.
GITHUB_APP_ID=

# Must byte-match the "Webhook secret" field in the App's settings. If these differ
# every delivery 401s; if this is unset every delivery 500s. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
GITHUB_WEBHOOK_SECRET=

# The downloaded .pem. Three accepted forms, in the order github.py tries them:
#   1. the literal PEM including the BEGIN/END lines (newlines may be escaped as \n)
#   2. base64 of the whole file, which is how most hosts want a multi-line secret:
#        base64 -w0 your-app.private-key.pem
#   3. leave this empty and set GITHUB_PRIVATE_KEY_PATH to a mounted file
GITHUB_PRIVATE_KEY=
# GITHUB_PRIVATE_KEY_PATH=/secrets/app.pem

# --- Reviewer agent: optional ---

# Without this the review still runs and posts, using deterministic analysis only, and
# the comment says so explicitly. It is not required for a working deployment.
OPENAI_API_KEY=
